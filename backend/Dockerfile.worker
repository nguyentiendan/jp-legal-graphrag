# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# JP Legal GraphRAG – worker
# Build: docker build -f backend/Dockerfile.worker backend
# On-prem / mạng nội bộ: override UV_IMAGE, PYTHON_IMAGE, UV_INDEX_URL bằng registry / PyPI mirror nội bộ.
# ---------------------------------------------------------------------------
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /usr/local/bin/uv
ARG UV_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=${UV_INDEX_URL} \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /src
# 1) Cài dependencies trước (cache layer khi chỉ sửa code)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
# 2) Cài project
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

FROM ${PYTHON_IMAGE} AS runtime
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DATA_DIR=/data \
    PROMPTS_DIR=/app/prompts \
    TZ=Asia/Tokyo
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home /app app \
    && mkdir -p /data /app && chown -R app:app /data /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app prompts /app/prompts
COPY --chown=app:app config /app/config
COPY --chown=app:app eval /app/eval
WORKDIR /app
USER app
VOLUME ["/data"]

CMD ["arq", "jplegal.worker.tasks.WorkerSettings"]

# ===== JP Legal GraphRAG – cấu hình on-prem =====
# cp .env.example .env  rồi sửa các giá trị bên dưới

# --- Cổng truy cập (Nginx) ---
WEB_BIND=0.0.0.0
WEB_PORT=8080

# --- Mật khẩu (BẮT BUỘC đổi) ---
POSTGRES_USER=jplegal
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jplegal
NEO4J_PASSWORD=change-me-neo4j
NEO4J_HEAP=1G
NEO4J_PAGECACHE=1G

# --- LLM (sinh câu trả lời) qua LiteLLM. Để trống LLM_MODEL = chỉ chạy retrieval ---
# vLLM nội bộ (OpenAI-compatible):
#   LLM_MODEL=openai/Qwen/Qwen3-32B-Instruct
#   LLM_API_BASE=http://10.0.0.20:8000/v1
#   LLM_API_KEY=dummy
# Ollama:
#   LLM_MODEL=ollama_chat/qwen3:32b
#   LLM_API_BASE=http://10.0.0.21:11434
# Cloud (nếu chính sách cho phép):
#   LLM_MODEL=openai/gpt-5-mini   LLM_API_KEY=sk-...
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# --- Model server (Ruri v3) ---
# trống = tự chọn cuda nếu có GPU, ngược lại cpu
MODEL_DEVICE=
MAX_SEQ_LENGTH=2048
# 1 = air-gapped: không tải từ HuggingFace, chỉ dùng model có sẵn trong volume "models"
HF_HUB_OFFLINE=0
# true = nhúng model vào image lúc build (image ~+2.5GB, tiện mang sang máy không có internet)
PRELOAD_MODELS=false

# --- Retrieval ---
DENSE_TOP_K=20
SEED_K=5
GRAPH_MAX=10
# slots (mặc định, dense là chính + tối đa GRAPH_SLOTS điều từ graph) | rrf (để so sánh)
FUSION_MODE=slots
GRAPH_SLOTS=2
RERANK_ENABLED=true
# CPU: nên giảm còn 10 / 800 để rerank không quá chậm
RERANK_TOP_N=20
RERANK_MAX_CHARS=3000
FINAL_K=6

# --- e-Gov 法令API ---
EGOV_API_BASE=https://laws.e-gov.go.jp/api/2
EGOV_BULK_URL=https://laws.e-gov.go.jp/bulkdownload
# giãn cách tối thiểu giữa 2 request (giây), áp dụng chung cho toàn hệ thống qua Redis
EGOV_MIN_INTERVAL_SEC=1.0
# cron hằng ngày lấy bản sửa đổi của các luật đã nạp
ENABLE_DAILY_UPDATE=false

# --- Mạng nội bộ: proxy / mirror (tuỳ chọn) ---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
PIP_INDEX_URL=https://pypi.org/simple
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NPM_REGISTRY=https://registry.npmjs.org/
# Registry nội bộ: đổi base image, ví dụ harbor.local/library/python:3.12-slim-bookworm
PYTHON_IMAGE=python:3.12-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.9
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.30-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
NEO4J_IMAGE=neo4j:5.26-community
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:8.2
IMAGE_PREFIX=jplegal
IMAGE_TAG=latest
